{
  "name": "wake-window",
  "version": "0.1.0",
  "private": true,
  "description": "Wake desktop window: a viewer of the Rust daemon, built on Electron and React",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/cpeaustriajc/wake",
  "type": "module",
  "main": "out/main/main.js",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "format": "oxfmt",
    "verify": "oxfmt --check && effect-tsgo oxlint --type-aware && effect-tsgo tsc -p tsconfig.json && effect-tsgo tsrs -p tsconfig.json && earnest verify src && vitest run && react-doctor . --yes --no-telemetry --no-supply-chain --blocking warning && electron-vite build"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.2",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "@xstate/react": "6.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "effect": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@effect/tsgo": "0.73.4",
    "@effect/vitest": "4.1.2",
    "@fast-check/vitest": "0.5.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@stylexjs/eslint-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.9.0",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.5.0",
    "electron-vite": "6.0.0",
    "eslint-plugin-no-comments": "1.2.1",
    "fast-check": "4.11.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "react-doctor": "0.9.23",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
