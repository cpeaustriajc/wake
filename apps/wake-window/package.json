{
  "name": "wake-window",
  "version": "0.1.0",
  "private": true,
  "description": "Wake desktop window: a viewer of the Rust daemon, built on Electron and SolidJS",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/cpeaustriajc/wake",
  "type": "module",
  "main": "out/main/main.js",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "format": "oxfmt",
    "verify": "oxfmt --check && oxlint --type-aware && tsc -p tsconfig.json && vitest run && electron-vite build"
  },
  "dependencies": {
    "@solidjs/web": "2.0.4",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/solid": "0.1.0-beta.17",
    "solid-js": "2.0.4",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "24.9.0",
    "electron": "45.5.0",
    "electron-vite": "6.0.0",
    "eslint-plugin-no-comments": "1.2.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
