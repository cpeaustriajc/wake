{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsx-a11y",
    "promise",
    "node"
  ],
  "jsPlugins": [
    "eslint-plugin-no-comments"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false
  },
  "ignorePatterns": [
    "src/renderer/keel/**",
    "out/**"
  ],
  "rules": {
    "no-comments/disallowComments": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "eslint/one-var": "off",
    "eslint/sort-vars": "off",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "oxc/no-async-await": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-optional-chaining": "off",
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "treatMethodsAsReadonly": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:net",
            "message": "Only src/main opens sockets."
          },
          {
            "name": "net",
            "message": "Only src/main opens sockets."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "electron.vite.config.ts",
        "vitest.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "tests/**"
      ],
      "plugins": [
        "vitest"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "src/main/**"
      ],
      "rules": {
        "import/no-nodejs-modules": "off",
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "localStorage",
          "sessionStorage"
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "solid-js",
                "message": "Only views in src/renderer use Solid."
              },
              {
                "name": "@solidjs/web",
                "message": "Only views in src/renderer use Solid."
              }
            ],
            "patterns": [
              {
                "regex": "^@ui-sdk/",
                "message": "Only views in src/renderer use UI SDK."
              },
              {
                "regex": "^#/(renderer|preload)/",
                "message": "The main process is a pipe to the daemon; it holds no view code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main/main.ts"
      ],
      "rules": {
        "node/no-process-env": "off",
        "node/no-top-level-await": "off"
      }
    },
    {
      "files": [
        "src/preload/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "process",
          "Buffer",
          "require",
          "__dirname",
          "__filename"
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:net",
                "message": "Only src/main opens sockets."
              },
              {
                "name": "net",
                "message": "Only src/main opens sockets."
              },
              {
                "name": "solid-js",
                "message": "Only views in src/renderer use Solid."
              },
              {
                "name": "@solidjs/web",
                "message": "Only views in src/renderer use Solid."
              }
            ],
            "patterns": [
              {
                "regex": "^@ui-sdk/",
                "message": "Only views in src/renderer use UI SDK."
              },
              {
                "regex": "^node:",
                "message": "Only src/main and the tests use Node."
              },
              {
                "regex": "^#/(renderer|main)/",
                "message": "The preload imports only src/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/renderer/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "process",
          "Buffer",
          "require",
          "__dirname",
          "__filename"
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:net",
                "message": "Only src/main opens sockets."
              },
              {
                "name": "net",
                "message": "Only src/main opens sockets."
              },
              {
                "name": "electron",
                "message": "Only src/main and src/preload use Electron."
              }
            ],
            "patterns": [
              {
                "regex": "^node:",
                "message": "Only src/main and the tests use Node."
              },
              {
                "regex": "^#/(main|preload)/",
                "message": "Views reach the daemon only through the bridge."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/renderer/**/*-model.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "process",
          "Buffer",
          "require",
          "__dirname",
          "__filename",
          "window",
          "document",
          "navigator",
          "localStorage",
          "sessionStorage"
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:net",
                "message": "Only src/main opens sockets."
              },
              {
                "name": "net",
                "message": "Only src/main opens sockets."
              },
              {
                "name": "electron",
                "message": "Only src/main and src/preload use Electron."
              },
              {
                "name": "solid-js",
                "message": "Only views in src/renderer use Solid."
              },
              {
                "name": "@solidjs/web",
                "message": "Only views in src/renderer use Solid."
              }
            ],
            "patterns": [
              {
                "regex": "^@ui-sdk/",
                "message": "Only views in src/renderer use UI SDK."
              },
              {
                "regex": "^node:",
                "message": "Only src/main and the tests use Node."
              },
              {
                "regex": "^#/(main|preload)/",
                "message": "Views reach the daemon only through the bridge."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "process",
          "Buffer",
          "require",
          "__dirname",
          "__filename",
          "window",
          "document",
          "navigator",
          "localStorage",
          "sessionStorage"
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:net",
                "message": "Only src/main opens sockets."
              },
              {
                "name": "net",
                "message": "Only src/main opens sockets."
              }
            ],
            "patterns": [
              {
                "regex": "^([^#]|#/(main|preload|renderer)/)",
                "message": "src/shared imports only src/shared."
              }
            ]
          }
        ]
      }
    }
  ]
}
